# Deploy target is Linux — keep text files LF everywhere so the same
# bytes run on the server regardless of which OS edited them.
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf

*.png binary
*.webp binary
*.jpg binary
*.svg text
*.pdf binary
*.sqrx binary
